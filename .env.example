# ── Core ─────────────────────────────────────────────────────────────
# PostgreSQL connection string of the APPLICATION role (NOSUPERUSER, NOBYPASSRLS): runs
# migrations and the app, so row-level security applies. Required in production.
DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon
# Public base URL of this Beacon deployment (canonical links, referral redirects, OAuth callbacks).
# Must be https:// in production (http is tolerated only for localhost).
BEACON_BASE_URL=http://localhost:3000
# 32-byte key (base64) for AES-256-GCM encryption of provider credentials (envelope key id "v1").
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BEACON_ENCRYPTION_KEY=
# Optional key ring for rotation: "kid:base64key,oldkid:base64key". The FIRST entry encrypts,
# every entry decrypts. After adding a key, run `pnpm secrets:rotate`, then drop the old one.
BEACON_ENCRYPTION_KEYS=
# Secret used to derive HMACs (visitor hashing, API key hashing). 32+ random bytes, base64. Required in production.
BEACON_HASH_SECRET=

# ── Database roles (see src/db/provision.ts, run by `pnpm release`) ───
# Superuser connection, used ONLY by `pnpm release` (provision) to create the roles below.
# Never give it to the web or worker processes.
DATABASE_ADMIN_URL=
# Application role created by provisioning (DATABASE_URL must connect as it). Password: 24+ chars.
BEACON_DB_APP_USER=beacon_app
BEACON_DB_APP_PASSWORD=
# BYPASSRLS system role used by trusted system code (auth lookups, job worker, key-resolved APIs).
# The app connects as it with DATABASE_URL's host and these credentials, or with DATABASE_SYSTEM_URL.
# Password: 24+ chars; required in production. Development defaults to beacon_system / beacon_system.
BEACON_DB_SYSTEM_USER=beacon_system
BEACON_DB_SYSTEM_PASSWORD=
DATABASE_SYSTEM_URL=
# Connection pool sizes (application and system pools).
DATABASE_POOL_MAX=10
DATABASE_SYSTEM_POOL_MAX=5

# ── Bootstrap (used by `pnpm db:seed`) ────────────────────────────────
BEACON_BOOTSTRAP_ORG_NAME=Novarys
BEACON_BOOTSTRAP_ORG_SLUG=novarys
BEACON_BOOTSTRAP_ADMIN_EMAIL=
BEACON_BOOTSTRAP_ADMIN_PASSWORD=

# ── Jobs ─────────────────────────────────────────────────────────────
# Run the background worker inside the web process (single-container deployments).
BEACON_EMBEDDED_WORKER=false
BEACON_WORKER_CONCURRENCY=2

# ── AI providers (all optional; Beacon runs deterministically without them) ──
ANTHROPIC_API_KEY=
BEACON_ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
BEACON_OPENAI_MODEL=
PERPLEXITY_API_KEY=
BEACON_PERPLEXITY_MODEL=sonar
# AI-visibility tests with Anthropic use the server-side web search tool (grounded answers with citations; billed per search). "false" samples ungrounded answers.
BEACON_ANTHROPIC_WEB_SEARCH=true

# ── Security ─────────────────────────────────────────────────────────
# Allow the crawler to fetch private/loopback addresses. NEVER enable in production.
# Outside production it also lets localhost / private-IP fixture sites (E2E) be audited
# without domain verification; public hosts always need a verified domain.
BEACON_SSRF_ALLOW_PRIVATE=false
# Optional endpoint that receives JSON error reports (error-tracking hook).
BEACON_ERROR_WEBHOOK_URL=

# One-time token required by /setup (first-run owner creation). Required in production while no user exists.
BEACON_SETUP_TOKEN=
# Number of trusted reverse proxies in front of the app that append to X-Forwarded-For
# (Railway: 1). The client IP is the entry that many hops from the right; 0 ignores the header.
BEACON_TRUSTED_PROXY_HOPS=1
# Beacon agent: default monthly token cap per organisation (input + output; 0 = no cap). Overridable per organisation in Settings.
BEACON_AGENT_MONTHLY_TOKEN_CAP=20000000
# Optional: callers sending this value in the x-beacon-health-secret header get detailed /api/health output.
BEACON_HEALTH_SECRET=

# ── Logging ──────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ── Google OAuth (Search Console "Connect with Google") ──────────────
# OAuth 2.0 client (type: Web application) from Google Cloud Console. Authorised redirect URI:
#   ${BEACON_BASE_URL}/api/integrations/google/callback
# Leave empty to use only the service-account connection.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Email notifications (optional) ─────────────────────────────────────
# Resend HTTPS API (https://resend.com). Both are required; without them the
# email channel is shown as "Not connected" and stays disabled.
RESEND_API_KEY=
# Verified sender, e.g. "Beacon <beacon@yourdomain.com>".
BEACON_EMAIL_FROM=

# ── docker-compose only ──────────────────────────────────────────────
# Password of the `postgres` superuser of the bundled database (used only by the release service).
POSTGRES_PASSWORD=
